setwd("C:/Users/IsmaSA/Desktop/Collaborations/Koushik")

list.files()
df <- read_xlsx("Time series .xlsx")
df <- df[!is.na(df$`Group ID`),]
head(df)
unique(df$`Group ID`)

df <- df %>%
  mutate(
    reproductive_stage = case_when(
      str_detect(`Group ID`, "E") ~ "Eggs",
      str_detect(`Group ID`, "N") ~ "Non reproductive",
      str_detect(`Group ID`, "G") ~ "Glair glands",
      TRUE                        ~ "Other"  )) 
      
df <- df %>%
  mutate(
    visit_duration = as.numeric(difftime(`Time Out`, `Time in`, units = "mins")))

individual_summary <- df %>%
  group_by(`Group ID`, reproductive_stage) %>%
  summarise(
    total_time = sum(visit_duration, na.rm = TRUE),
    n_visits = n(),
    avg_time_per_visit = total_time / n_visits,
    .groups = "drop" )

str(individual_summary)
summary_stats <- individual_summary %>% as.data.frame() %>%
  mutate(reproductive_stage = str_trim(reproductive_stage))  %>%
  group_by(reproductive_stage) %>%
  summarise(
    avg_time_spent = mean(total_time, na.rm = TRUE),
    sd_time_spent = sd(total_time, na.rm = TRUE),
    
    avg_visits = mean(n_visits, na.rm = TRUE),
    sd_visits = sd(n_visits, na.rm = TRUE),
    
    avg_time_per_visit = mean(avg_time_per_visit, na.rm = TRUE),
    sd_time_per_visit = sd(avg_time_per_visit) )

summary_stats$sd_time_per_visit2 = c(106.85,1.60,12.60)

sd = individual_summary %>% group_by(reproductive_stage) %>% 
  summarise(sd= sd(avg_time_per_visit))

p1<- ggplot(summary_stats, aes(x = reproductive_stage, y = avg_time_spent,
        fill = reproductive_stage)) +
  geom_col(color='black', size= 0.2) +
  labs(
    y = "Average time per in the shelter", x=""
  ) +
  geom_errorbar(
    aes(ymin = pmax(0, avg_time_spent - sd_time_spent),
        ymax = avg_time_spent + sd_time_spent),
    width = 0.2
  )+
  theme_bw() + theme(legend.position = "none") +
  scale_x_discrete(labels = c(
    "Eggs"            = "Eggs",
    "Glair glands"    = "Glair glands",
    "Non reproductive"= "Non reproductive"
  ))+
  scale_fill_manual(
    values = c(
      "Eggs" = "forestgreen",
      "Non reproductive" = "deepskyblue3",
      "Glair glands" = "chocolate3")) 
p1
# Bar plot of total time (minutes) by reproductive stage
p2<- ggplot(summary_stats, aes(x = reproductive_stage, y = avg_visits, fill = reproductive_stage)) +
  geom_col(color='black', size= 0.2) +
  labs(
    y = "Average number of visits", x=""
  ) +
  theme_bw() + theme(legend.position = "none") +
  geom_errorbar(
    aes(ymin = pmax(0, avg_visits - sd_visits),
        ymax = avg_visits + sd_visits),
    width = 0.2
  )+
  scale_x_discrete(labels = c(
    "Eggs"            = "Eggs",
    "Glair glands"    = "Glair glands",
    "Non reproductive"= "Non reproductive"
  ))+
  scale_fill_manual(
    values = c(
      "Eggs" = "forestgreen",
      "Non reproductive" = "deepskyblue3",
      "Glair glands" = "chocolate3")) 
p2
# Bar plot of average time (minutes) by reproductive stage
p3<- ggplot(summary_stats, aes(x = reproductive_stage, y = avg_time_per_visit, fill = reproductive_stage)) +
  geom_col(color='black', size= 0.2) +
  labs(
    y = "Average time (min)", x=""
  ) +
  theme_bw() + theme(legend.position = "none") +
  geom_errorbar(
    aes(ymin = pmax(0, avg_time_per_visit - sd_time_per_visit2),
        ymax = avg_time_per_visit + sd_time_per_visit2),
    width = 0.2
  )+
  scale_x_discrete(labels = c(
    "Eggs"            = "Eggs",
    "Glair glands"    = "Glair glands",
    "Non reproductive"= "Non reproductive"
  ))+
  scale_fill_manual(
    values = c(
      "Eggs" = "forestgreen",
      "Non reproductive" = "deepskyblue3",
      "Glair glands" = "chocolate3")) 

p3
p1 + p2 + p3






ggplot(
  data = df,
  aes(
    x = `Time in`,           # Start of each visit
    xend = `Time Out`,       # End of each visit
    y = `Group ID`,          # Group ID on y-axis
    yend = `Group ID`,       # Must match y to make a horizontal segment
    color = reproductive_stage
  )
) +
  geom_segment(size = 2) +
  scale_x_datetime(
    date_breaks = "1 hour",   # Adjust as needed
    date_labels = "%H:%M"     # Only show time (HH:MM)
  ) +
  labs(
    x = "Time",
    y = "Group ID",
    color = "Reproductive Stage"
  ) +
  theme_bw() + 
  scale_color_manual(
    values = c(
      "Eggs" = "forestgreen",
      "Non_reproductive" = "deepskyblue3",
      "Glair_glands" = "chocolate3")) 


# Old plots:
library(frair)
df <- read_excel("Tonda_student.xlsx", sheet = "Ismael")
df[is.na(df)] <- 0

df1<- df[,c(1:11)] #Group Non-reproductive
df2<- df[,c(2,12:20)] #Group Glands
df3<- df[,c(2,21:29)] #Group Eggs

frair_test(formula = Total  ~  `Prey density` , data = df1) 
frair_test(formula = Total1  ~  `Prey density` , data = df2)
frair_test(formula = Total2  ~  `Prey density` , data = df3) 


## Result

#Functional response analyse
#a: attack rate
#h: handling time
#T: time exp

g_fit1 <- frair_fit(formula = Total ~ `Prey density`, data = df1,
                    response = "rogersII",
                    start = list(a = 1, h = 0.1),
                    fixed = list(T = 1)) 
with(df1, plot(`Prey density`, Total, xlab="Prey Density",
               ylab="No. Prey Eaten"))
lines(g_fit1, lty = 1, col = "grey25")
print(g_fit1)
summary(g_fit1$fit)


g_fit2 <- frair_fit(formula = Total1 ~ `Prey density`, data = df2,
                    response = "rogersII",
                    start = list(a = 1, h = 0.1),
                    fixed = list(T = 1)) #days
with(df2, plot(`Prey density`, Total1, xlab="Prey Density",
               ylab="No. Prey Eaten"))
lines(g_fit2, lty = 1, col = "grey55")
print(g_fit2)
summary(g_fit2$fit)


g_fit3 <- frair_fit(formula = Total2 ~ `Prey density`, data = df3,
                    response = "rogersII",
                    start = list(a = 1, h = 0.1),
                    fixed = list(T = 1)) #days
with(df3, plot(`Prey density`, Total2, xlab="Prey Density",
               ylab="No. Prey Eaten"))
lines(g_fit3, lty = 1, col = "grey55")
print(g_fit3)
summary(g_fit3$fit)



fitp_fit1 <- frair_boot(g_fit1)
confint(fitp_fit1 , citypes ='bca')

fitp_fit2 <- frair_boot(g_fit2)
confint(fitp_fit2 , citypes ='bca')

fitp_fit3 <- frair_boot(g_fit3)
confint(fitp_fit3 , citypes ='bca')


