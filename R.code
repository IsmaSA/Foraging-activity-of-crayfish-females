### Check the attack rate (a) and handling time (h) through error bars from bootstraps


########### Ahora plot boxplots

a<- fitp_fit1$bootcoefs %>% as.data.frame() %>% mutate(Lower="2.883",
                                                       Upper="8.81",
                                                       point="4.600") 
a$Clawless <- "Non-reproductive"
b<- fitp_fit2$bootcoefs %>% as.data.frame()%>% mutate(Lower="1.372",
                                                      Upper="4.322",
                                                      point="2.447")
b$Clawless <- "Glair glands"
c<- fitp_fit3$bootcoefs %>% as.data.frame()%>% mutate(Lower="0.25",
                                                      Upper="7.863",
                                                      point="1.044")
c$Clawless <- "Eggs"

df<- bind_rows(a,b,c)
str(df)

str(df)
df$Lower<- as.numeric(df$Lower)
df$Upper<- as.numeric(df$Upper)
df$point<- as.numeric(df$point)

df$Clawless <- factor(df$Clawless, 
                      levels = c("Non-reproductive","Glair glands","Eggs"))

df <- df[!duplicated(df$Clawless),]

#svg("p1.svg")
p<- ggplot(df, aes(Clawless,a,colour = Clawless)) 
p1<- p + geom_errorbar(aes(ymin = Lower, ymax = Upper), width = 0.2) +theme_bw(base_size = 14) + ylab("Attack rate (± SE)")+
  ylim(0,10)+ geom_point(data=df,aes(Clawless,point)) +
  xlab("")+theme(legend.position = "none") +
  scale_color_manual(
    values = c(
      "Eggs" = "forestgreen",
      "Non-reproductive" = "deepskyblue3",
      "Glair glands" = "chocolate3")) 
p1 
