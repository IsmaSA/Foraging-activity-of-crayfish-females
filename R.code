### Experiment 2 -------------

df= read_xlsx('FR REPRODUCTION STATUS OF FEMALES complete.xlsx', sheet =2)


g =df[,c(1:12)]
e =df[,c(14:25)]
n =df[,c(27:38)]

nam = c('Code','NA','NA','CL','W','Note','Alive','E100','E75','E50','E25','E0')
colnames(g) = nam
colnames(e) = nam
colnames(n) = nam

g =g[-1,]
e =e[-1,]
n =n[-1,]

g =g[,-2]
e =e[,-2]
n =n[,-2]

g <- g %>%
  rename_with(.fn = make.unique) %>%
  mutate(
    Shelter = ifelse(grepl("\\+", Code), "Shelter", "No shelter"))
e <- e %>%
  rename_with(.fn = make.unique) %>%
  mutate(
    Shelter = ifelse(grepl("\\+", Code), "Shelter", "No shelter"))
n <- n %>%
  rename_with(.fn = make.unique) %>%
  mutate(
    Shelter = ifelse(grepl("\\+", Code), "Shelter", "No shelter"))

g$killed <- rowSums(
  cbind(g$E100, g$E75, g$E50, g$E25, as.numeric(g$E0)),na.rm = TRUE)
e$killed <- rowSums(
  cbind(e$E100, e$E75, e$E50, e$E25, as.numeric(e$E0)),na.rm = TRUE)
n$killed <- rowSums(
  cbind(n$E100, n$E75, n$E50, n$E25, as.numeric(n$E0)),na.rm = TRUE)
g$type ='Glair glands'
e$type ='Eggs'
n$type ='Non reproductive'
d= cbind(g[,c(1,12,13,14)], e[,c(1,12,13,14)], n[,c(1,12,13,14)])

names(d) <- make.unique(names(d))

d_long <- d %>%
  mutate(row = row_number()) %>%
  pivot_longer(
    cols = -row,
    names_to = c(".value", "group"),
    names_pattern = "(Code|Shelter|killed|type)(\\d*)"
  ) %>%
  dplyr::select(-group)


df_summary <- d_long %>%
  group_by(Shelter, type) %>%
  summarise(
    mean_killed = mean(killed, na.rm = TRUE),
    se_killed = sd(killed, na.rm = TRUE) / sqrt(n()),
    .groups = "drop")

# Shelter presence vs absence 
df_summary$type[df_summary$type == "Non reproductive"] <- "Non-reproductive"
d_long$type[d_long$type == "Non reproductive"] <- "Non-reproductive"

ggplot(df_summary, aes(x = type, y = mean_killed, fill = type)) +
  geom_col(position = position_dodge(width = 0.9), width = 0.7, color='black', size=0.1) +
  geom_errorbar(aes(ymin = mean_killed - se_killed,
                    ymax = mean_killed + se_killed),
                width = 0.2,
                position = position_dodge(width = 0.9))  + 
  facet_wrap(~ Shelter, labeller = as_labeller(c("Shelter" = "Shelter present", "No shelter" = "Shelter absent"))) +
  scale_fill_manual(
    values = c(
      "Eggs" = "forestgreen",
      "Non-reproductive" = "deepskyblue3",
      "Glair glands" = "chocolate3")) + labs(y = "No. of prey killed", x = NULL) +
  theme_bw() +
  theme(
    legend.position = "none",
    axis.title = element_text(face="bold"),
    strip.text = element_text(face = "bold", size = 12))


# Model to test the reliance on feeding vc sheltering in depending on their reproduction
# Here it is using exp 2
head(d_long)
glimpse(d_long)
d_long$Shelter <- as.factor(d_long$Shelter)
d_long$type <- as.factor(d_long$type)

table(d_long$Shelter, d_long$type)


mod1 <- glm(killed ~ Shelter * type, family = poisson(link = "log"), data = d_long)
summary(mod1)
overdispersion <- sum(residuals(mod1, type = "pearson")^2) / df.residual(mod1)
print(overdispersion)  # If > 1.5–2, use negative binomial
library(emmeans)
emmeans(mod1, pairwise ~ Shelter | type)
emmeans(mod1, pairwise ~ type | Shelter)


em_results <- emmeans(mod1, pairwise ~ Shelter | type)
subset(em_results$contrasts, type == "Non-reproductive")



# Here it is using exp 3 ----
exp3= read_xlsx('FR REPRODUCTION STATUS OF FEMALES complete.xlsx', sheet =3)[c(1:32),]

e =exp3[,c(27:38)]
e =e[,-c(3,4,5,6,7)]
g =exp3[,c(14:25)]
g =g[,-c(3,4,5,6,7)]
n =exp3[,c(1:12)]
n =n[,-c(3,4,5,6,7)]

nam = c('Code','Shelter','E100','E75','E50','E25','E0')
colnames(g) = nam
colnames(e) = nam
colnames(n) = nam

g$killed <- rowSums(
  cbind(g$E100, g$E75, g$E50, g$E25, as.numeric(g$E0)),na.rm = TRUE)
e$killed <- rowSums(
  cbind(e$E100, e$E75, e$E50, e$E25, as.numeric(e$E0)),na.rm = TRUE)
n$killed <- rowSums(
  cbind(n$E100, n$E75, n$E50, n$E25, as.numeric(n$E0)),na.rm = TRUE)
g$type ='Glair glands'
e$type ='Eggs'
n$type ='Non reproductive'


d= rbind(g[,c(1,2,8,9)], e[,c(1,2,8,9)], n[,c(1,2,8,9)])
d <- d[,-1]

glimpse(d)
d$Shelter[d$Shelter == "-"] <- "No shelter"
d$Shelter[d$Shelter == "+"] <- "Shelter"

d$Shelter <- as.factor(d$Shelter)
d$type <- as.factor(d$type)

table(d$Shelter, d$type)

p2<- ggplot(d, aes(x = Shelter, y = killed, fill = type)) +
  geom_boxplot(position = position_dodge()) +
  labs(y = "No. prey eaten", x = "Shelter presence", fill = "Reproductive stage") +
  theme_bw(base_size = 14) +  scale_fill_manual(
    values = c(
      "Eggs" = "forestgreen",
      "Non reproductive" = "deepskyblue3",
      "Glair glands" = "chocolate3"))

mod2 <- glm(killed ~ Shelter * type, family = poisson(link = "log"), data = d)
summary(mod2)
overdispersion <- sum(residuals(mod2, type = "pearson")^2) / df.residual(mod2)
print(overdispersion)  # If > 1.5–2, use negative binomial
library(emmeans)
emmeans(mod2, pairwise ~ Shelter | type)

p1  + p2 
