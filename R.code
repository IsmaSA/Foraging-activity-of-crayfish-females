## Partial consumption of prey

df <- read_excel("Tonda_student.xlsx", sheet = "Ismael")
head(df)

df[is.na(df)] <- 0

df1<- df[,c(1:10)] #Group Non-reproductive
df1 <- df1[,-1]
colnames(df1) <- c("Prey.density","Code","Alive",
            "Killed","0.75.Killed","0.5.Killed","0.25.Killed","0.Killed","Total")

df2<- df[,c(2,11:18)] #Group eggs
colnames(df2) <- c("Prey.density",'NA', "Code","Alive",
                   "Killed","0.75.Killed","0.5.Killed","0.25.Killed","0.Killed")
df3<- df[,c(2,19:27)] #Group glands
colnames(df3) <- c("Prey.density",'NA','NA', "Code","Alive",
                   "Killed","0.75.Killed","0.5.Killed","0.25.Killed","0.Killed")

df1 <- df1[,-9]
df2 <- df2[,-2]
df3 <- df3[,-c(2,3)]

df<- rbind(df1,df2,df3)

df$Partial <- df$`0.75.Killed` + df$`0.5.Killed` + df$`0.25.Killed`+ df$`0.25.Killed`
df$Full <- df$Killed + df$Partial 


df$Code <- as.factor(df$Code)
head(df)

### Zero inflated because there are mannnnnnnnnnnny 0 (more than expected)
head(df)
str(df)
hist(df$Partial)


model1 <- glmmTMB(cbind(Partial, Full) ~ Code*Prey.density, ziformula = ~1,
                  data = df, family = binomial(link = "logit"))
summary(model1)


library(car)
result<-car::Anova(model1, Type=3)
result

library(lsmeans)
lsmeans(model1,pairwise~Code,data=df) 

## Repeat the model for exp 2  ----

df <- read_excel("Tonda_student.xlsx", sheet = "Experiment 2")
head(df)

df = df[,-c(2:6,13,15:19,26,28:32)]

df1<- df[,c(1:7)] 
df1 = df1[-1,]
colnames(df1) <- c("Code","Alive","Killed","0.75.Killed","0.5.Killed",
                  "0.25.Killed","0.Killed")

df2<- df[,c(8:14)] #Group eggs
df2 = df2[-1,]
colnames(df2) <- c("Code","Alive","Killed","0.75.Killed","0.5.Killed",
                   "0.25.Killed","0.Killed")

df3<- df[,c(15:21)] #Group glands
df3 = df3[-1,]
colnames(df3) <-c("Code","Alive","Killed","0.75.Killed","0.5.Killed",
                  "0.25.Killed","0.Killed")

df<- rbind(df1,df2,df3)
df = df[!is.na(df$Code),]

df$`0.Killed` <- as.numeric(df$`0.Killed`)
df$`0.25.Killed` <- as.numeric(df$`0.25.Killed`)
df$`0.5.Killed` <- as.numeric(df$`0.5.Killed`)
df$`0.75.Killed` <- as.numeric(df$`0.75.Killed`)

df[is.na(df)] <- 0

df$Partial <- df$`0.75.Killed` + df$`0.5.Killed` + df$`0.25.Killed`+ df$`0.25.Killed`
df$Full <- df$Killed + df$Partial 

str(df)
df$Group <- substr(df$Code, 1, 1)
model2 <- glmmTMB(cbind(Partial, Full) ~ Group, ziformula = ~1,
                  data = df, family = binomial(link = "logit"))
summary(model2)


library(car)
result<-car::Anova(model2, Type=3)
result

library(lsmeans)
lsmeans(model2,pairwise~Group,data=df) 

## Partial consumption plot (all groups combined)

exp1= read_xlsx('FR REPRODUCTION STATUS OF FEMALES complete.xlsx', sheet =1)[,c(1:3,13,14:16,26:29,39)]
exp2= read_xlsx('FR REPRODUCTION STATUS OF FEMALES complete.xlsx', sheet =2)[,c(1:3,13,14:16,26:29,39)]
exp3= read_xlsx('FR REPRODUCTION STATUS OF FEMALES complete.xlsx', sheet =3)[,c(1:3,13,14:16,26:29,39)]

exp1= exp1[c(1:72), ]
exp1= exp1[,-c(3,7,11) ]
exp2= exp2[c(1:54), ]
exp2= exp2[,-c(2,3,6,7,10,11) ]
exp2$Prey= 12
exp3= exp3[c(1:32), ]
exp3= exp3[,-c(2,3,6,7,10,11) ]
exp3$Prey= 12

colnames(exp1) <- c(
  "Code_N", "Prey_N", "Partial_N","Code_G", "Prey_G", "Partial_G","Code_E", "Prey_E", "Partial_E")
exp1 <- exp1 %>% mutate(RowID = row_number())

exp1_long <- exp1 %>%
  pivot_longer(
    cols = c(Code_N, Prey_N, Partial_N,
             Code_G, Prey_G, Partial_G,
             Code_E, Prey_E, Partial_E),
    names_to = c(".value", "Group"),names_sep = "_"  ) %>%
  dplyr::select(Group, Prey, Partial)


colnames(exp2) <- c(
  "Code_G","Partial_G","Code_E", "Partial_E", "Code_N","Partial_N", "Prey")
exp2 <- exp2 %>% mutate(RowID = row_number())

exp2_long <- exp2 %>%
  pivot_longer(
    cols = c(Code_G, Partial_G, Code_E, Partial_E, Code_N, Partial_N),
    names_to = c(".value", "Group"),
    names_sep = "_" ) %>%  
  dplyr::select(Group, Prey, Partial)

colnames(exp3) <- c(
  "Code_N","Partial_N","Code_G", "Partial_G", "Code_E","Partial_E", "Prey")
exp3 <- exp3 %>% mutate(RowID = row_number())

exp3_long <- exp3 %>%
  pivot_longer(
    cols = c(Code_G, Partial_G, Code_E, Partial_E, Code_N, Partial_N),
    names_to = c(".value", "Group"),
    names_sep = "_" ) %>%  
  dplyr::select(Group, Prey, Partial)

exp1_long$Experiment = 'Experiment 1'
exp2_long$Experiment =  'Experiment 2'
exp3_long$Experiment =  'Experiment 3'

full.df = rbind(exp1_long,exp2_long,exp3_long)
summary_stats <- full.df %>%
  group_by(Group, Prey, Experiment) %>%
  summarise(
    mean_partial = mean(Partial, na.rm = TRUE),
    sd_partial = sd(Partial, na.rm = TRUE),.groups = "drop")

summary_stats <- summary_stats %>%
  mutate(Prey_density = factor(Prey, levels = c(1, 3, 6, 12, 18, 24)))

ggplot(summary_stats, aes(x = Prey, y = mean_partial, ymin = mean_partial - sd_partial, ymax = mean_partial + sd_partial)) +
  geom_hline(yintercept = 0, linetype = "dashed", color = "black") +
  geom_pointrange(
    aes(color = Group, shape = Experiment),
    position = position_dodge(width = 4),
    size = 0.8,
    fatten = 2
  ) +
  theme_bw(base_size = 14) +
  theme(
    legend.position = "right",
    axis.title = element_text(face = "bold")) +
  ylab("Prey partially consumed") +
  scale_x_discrete(
    name = "Prey density",
    limits = c("1", "3", "6", "12", "18", "24")
  ) +
  scale_color_manual(
    values = c(
      "E" = "forestgreen",
      "N" = "deepskyblue3",
      "G" = "chocolate3"))




